NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_ENABLED=true
NEXT_PUBLIC_SITE_URL=https://crewfind.vercel.app
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_DISCORD_AUTH_ENABLED=false
# Demo yalnızca açıkça true yapıldığında çalışır. Production'da false kalmalıdır.
NEXT_PUBLIC_DEMO_MODE=false

# AdSense yalnız hesap/site onayı ve Google onaylı CMP tamamlandıktan sonra
# açılır. Tek masaüstü sticky rail kullanılır; teklif ve lobi ekranında gösterilmez.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_DESKTOP_SLOT=

# Yalnız sunucu tarafında kullanılır. NEXT_PUBLIC_ öneki eklemeyin.
PARSE_BOT_API_KEY=
SUPABASE_SECRET_KEY=
ADSENSE_PUBLISHER_ID=

# Geri bildirim iletimi. Gmail kullanırken uygulama parolası yalnız bu sunucu
# değişkeninde tutulur; NEXT_PUBLIC_ öneki kullanılmaz.
FEEDBACK_SMTP_HOST=smtp.gmail.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=

# Riot RSO onayı gelmeden false kalır. Secret değerleri public env olarak eklemeyin.
NEXT_PUBLIC_RIOT_AUTH_ENABLED=false
